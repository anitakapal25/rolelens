# --- Required: API keys (never commit real values) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Models ---
CHAT_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5
EMBEDDING_MODEL=text-embedding-3-small

# --- Vector DB (Chroma) ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=rolelens_chunks

# --- Storage ---
REGISTRY_DB_PATH=./data/registry.sqlite3

# --- Upload limits ---
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=10

# --- Chunking ---
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# --- Retrieval ---
TOP_K_PER_DOC=4
TOP_K_RESUME=6
RESUME_FULL_MAX_CHUNKS=12
MAX_DISTANCE=0.85

# --- Chat ---
CHAT_EFFORT=low
CHAT_MAX_TOKENS=4000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
